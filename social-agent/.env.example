# BlockDNS Social Agent configuration.
# Copy to social-agent/.env (or put keys in the repo-root .env).
# NEVER commit real tokens. store.json + events.jsonl are gitignored.

# Shared protocol identity
TREASURY_ADDRESS=0xe0Bff551891cb718E351522fb798AbF9ac71Fbfe

# Logging: debug | info | warn | error
SOCIAL_LOG_LEVEL=info

# Set 1 to render-but-never-send (safety rehearsal)
SOCIAL_DRY_RUN=0
# Hard daily cap shared by all publishing platforms
SOCIAL_MAX_POSTS_PER_DAY=8
# Daemon poll cadence in ms
SOCIAL_POLL_INTERVAL_MS=60000
# HTTP timeout ms
SOCIAL_FETCH_TIMEOUT_MS=20000

# Persistence (all gitignored)
SOCIAL_STORE_FILE=./store.json
SOCIAL_EVENTS_FILE=./events.jsonl
SOCIAL_SCHEDULE_FILE=./schedule.json

# ---------------- Telegram ----------------
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Official group/channel chat id where alerts + live events are broadcast
TELEGRAM_CHAT_ID=
# Supergroup topic thread id (optional)
TELEGRAM_THREAD_ID=
# 1 = only react when the message mentions .bdns/blockdns or a command (anti-spam group mode)
TELEGRAM_REQUIRE_KEYWORD=0

# ---------------- X (Twitter) API v2 ----------------
# OAuth 1.0a user-context credentials (X Developer Portal -> User authentication)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# App-only Bearer token, required for keyword search monitoring
TWITTER_BEARER_TOKEN=
# Your handle WITHOUT '@' (used to skip own tweets)
TWITTER_HANDLE=BlockDNS
# Max auto-replies per hour across mentions + keywords (keep low to avoid flags)
TWITTER_REPLIES_PER_HOUR=4
# Comma separated keyword phrases for engagement automation
TWITTER_KEYWORDS=Web3 Domains,ENS alternatives,Decentralized Hosting
# Daily educational post time (UTC, 24h)
TWITTER_DAILY_POST_UTC=12:00

# ---------------- Meta Graph API (Instagram + Facebook) ----------------
META_APP_ID=
META_APP_SECRET=
# Short-lived user access token; the agent exchanges it for a long-lived one and stores it
META_USER_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ID=
META_GRAPH_VERSION=v21.0
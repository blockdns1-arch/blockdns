# Which of the four BlockDNS sites this deployment is. Each Vercel project sets its own
# value: blockdns-home=home, blockdns-swap=swap, blockdns-explorer=explorer,
# blockdns-founder=founder. Drives branding, navigation and landing copy.
NEXT_PUBLIC_SITE=home

# Public URLs of the four sites, used for cross-links in the navbar and landing pages.
NEXT_PUBLIC_SITE_HOME_URL=https://blockdns-home.vercel.app
NEXT_PUBLIC_SITE_SWAP_URL=https://blockdns-swap.vercel.app
NEXT_PUBLIC_SITE_EXPLORER_URL=https://blockdns-explorer.vercel.app
NEXT_PUBLIC_SITE_FOUNDER_URL=https://blockdns-founder.vercel.app

NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_L2_CHAIN_ID=84532
NEXT_PUBLIC_L2_CHAIN_NAME=Base Sepolia
NEXT_PUBLIC_L2_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_L2_EXPLORER_NAME=Basescan
NEXT_PUBLIC_L2_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=Ether
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_PRICER_ADDRESS=
NEXT_PUBLIC_BDNS_ADDRESS=
NEXT_PUBLIC_RESOLVER_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_SWAP_ADDRESS=
NEXT_PUBLIC_BRIDGE_ADDRESS=
NEXT_PUBLIC_BURN_ENGINE_ADDRESS=
NEXT_PUBLIC_STAKING_VAULT_ADDRESS=
NEXT_PUBLIC_SPLITTER_ADDRESS=
NEXT_PUBLIC_MESSENGER_ADDRESS=
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.basescan.org
NEXT_PUBLIC_PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud
